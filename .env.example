# ─── Server ────────────────────────────────
PORT=8000
NODE_ENV=production

# ─── MongoDB ───────────────────────────────
# The app reads DB_URL. (MONGO_URI is kept for reference only.)
DB_URL=mongodb://127.0.0.1:27017/bariwala
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bariwala

# ─── JWT ───────────────────────────────────
# REQUIRED in production – use a long random string. Without it a weak fallback secret is used.
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# ─── Cookie ────────────────────────────────
# Number of days before cookie expires
COOKIE_EXPIRE=7

# ─── Cross-origin (optional) ───────────────
# Leave EMPTY when the React build is served by this server (default / Vercel setup).
# Only set it if the client is hosted on a different domain, e.g. https://app.example.com
# (comma separate several). This also switches the login cookie to SameSite=None; Secure.
CLIENT_ORIGIN=

# ─── Cloudinary ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
