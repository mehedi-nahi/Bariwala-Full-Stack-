# ─── Server ────────────────────────────────
PORT=8000
NODE_ENV=production

# ─── MongoDB ───────────────────────────────
DB_URL=mongodb://127.0.0.1:27017/bariwala
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bariwala

# ─── JWT ───────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# ─── Cookie ────────────────────────────────
# Number of days before cookie expires
COOKIE_EXPIRE=7

# ─── Cloudinary ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
