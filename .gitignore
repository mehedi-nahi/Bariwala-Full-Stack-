# ══════════════════════════════════════════════════════
#  Bariwala — .gitignore
# ══════════════════════════════════════════════════════

# ─── Environment / secrets ────────────────────────────
.env
.env.*
!.env.example

# ─── Dependencies ─────────────────────────────────────
node_modules/
client/node_modules/

# ─── Uploaded user files (keep folder via .gitkeep) ───
uploads/*
!uploads/.gitkeep

# ─── Demo data folder (seed images + scripts) ─────────
demo_data/

# ─── Frontend build output ────────────────────────────
client/dist/
client/dist-ssr/

# ─── Logs ─────────────────────────────────────────────
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# ─── OS generated files ───────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDE / Editor ─────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.project
.classpath
.settings/

# ─── Runtime / temp files ─────────────────────────────
*.pid
*.seed
*.pid.lock
*.local
.cache/
tmp/
temp/

# ─── Coverage & testing ───────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/

# ─── Build artifacts ──────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/

# ─── Package manager locks (keep one) ────────────────
# yarn.lock  ← uncomment if you use yarn
# pnpm-lock.yaml ← uncomment if you use pnpm
# package-lock.json is intentionally committed for npm

# ─── Misc ─────────────────────────────────────────────
*.bak
*.orig
*.patch
.eslintcache
.stylelintcache
